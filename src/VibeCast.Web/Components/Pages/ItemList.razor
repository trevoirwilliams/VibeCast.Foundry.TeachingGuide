@if (Items.Length == 0)
{
    <p class="text-muted mb-0">
        None identified.
    </p>
}
else
{
    <ul class="mb-0">
        @foreach (string item in Items)
        {
            <li>@item</li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired]
    public string[] Items { get; set; } = [];
}
