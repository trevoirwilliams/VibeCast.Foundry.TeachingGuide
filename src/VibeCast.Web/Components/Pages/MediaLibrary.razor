@page "/media"
@attribute [Authorize]
@using System.Security.Claims
@using VibeCast.Application.Common
@inject IMediaAssetService MediaAssetService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MediaLibrary> Logger

<PageTitle>Source gallery</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Content</div>
        <h1>Source gallery</h1>
        <p>Review reusable PDF and text research uploaded independently of an episode.</p>
    </div>

    <a class="btn btn-primary" href="/media/upload">Upload source</a>
</div>

@if (isLoading)
{
    <section class="surface-card">
        <div class="empty-state compact">
            <div class="empty-icon">…</div>
            <div>
                <strong>Loading sources</strong>
                <p>Retrieving your shared research files.</p>
            </div>
        </div>
    </section>
}
else
{
    <ErrorMessage Message="@loadError" />

    @if (string.IsNullOrWhiteSpace(loadError) && sources.Count == 0)
    {
        <div class="empty-state large">
            <div class="empty-icon">＋</div>
            <div>
                <h2>No shared sources yet</h2>
                <p>Upload a PDF or TXT research file to begin your reusable source gallery.</p>
                <a class="btn btn-primary" href="/media/upload">Upload source</a>
            </div>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(loadError))
    {
        <div class="media-card-grid mt-3">
            @foreach (MediaAssetSummary source in sources)
            {
                <MediaAssetCard Asset="@source"
                                ContextLabel="Shared source"
                                Summary="Reusable research source available to VibeCast.">
                    <Actions Context="asset">
                        <a class="btn btn-sm btn-outline-primary"
                           href="@($"/media/{asset.Id:D}/content")">
                            Open source
                        </a>
                    </Actions>
                </MediaAssetCard>
            }
        </div>
    }
}

@code {
    private IReadOnlyList<MediaAssetSummary> sources = [];
    private bool isLoading;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            AuthenticationState authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            string? ownerId = authenticationState.User
                .FindFirst(ClaimTypes.NameIdentifier)?
                .Value;

            if (string.IsNullOrWhiteSpace(ownerId))
            {
                loadError =
                    "The authenticated user could not be resolved. Sign in again and retry.";
                return;
            }

            sources = await MediaAssetService.ListSharedSourcesAsync(ownerId);
        }
        catch (SafeApplicationException exception)
        {
            Logger.LogWarning(exception, "The Source Gallery query could not be completed.");
            loadError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the Source Gallery.");
            loadError = "VibeCast could not load the Source Gallery. Retry in a moment.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
