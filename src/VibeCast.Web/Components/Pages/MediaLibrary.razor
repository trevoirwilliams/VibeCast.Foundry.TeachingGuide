@page "/media"
@attribute [Authorize]
@using System.Security.Claims
@using VibeCast.Infrastructure.Media
@inject IMediaAssetService MediaAssetService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MediaLibrary> Logger

<PageTitle>Media library</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Content</div>
        <h1>Media library</h1>

        <p>
            Review source files that passed the
            VibeCast intake boundary.
        </p>
    </div>

    <a class="btn btn-primary"
       href="/media/upload">
        Upload media
    </a>
</div>

@if (isLoading)
{
    <section class="surface-card">
        <div class="empty-state compact">
            <div class="empty-icon">…</div>

            <div>
                <strong>Loading media</strong>
                <p>Retrieving your validated assets.</p>
            </div>
        </div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger" role="alert">
        @loadError
    </div>
}
else if (assets.Count == 0)
{
    <div class="empty-state large">
        <div class="empty-icon">＋</div>

        <div>
            <h2>No media yet</h2>

            <p>
                Upload an image, WAV recording, or PDF
                to begin the multimodal media package.
            </p>

            <a class="btn btn-primary"
               href="/media/upload">
                Upload source media
            </a>
        </div>
    </div>
}
else
{
    <div class="media-card-grid mt-3">
        @foreach (MediaAssetSummary asset in assets)
        {
            <article class="media-tile">
                <div class="media-preview @GetPreviewClass(asset)">
                    <span>@GetTypeCode(asset)</span>
                </div>

                <div class="media-copy">
                    <div class="d-flex justify-content-between gap-2">
                        <strong>
                            @asset.OriginalFileName
                        </strong>

                        <span class="status-badge badge-info">
                            @asset.Status
                        </span>
                    </div>

                    <small>
                        @asset.ContentType
                        · @FormatSize(asset.SizeBytes)
                    </small>

                    <p>
                        Accepted for later multimodal processing.
                    </p>

                    <div class="media-meta">
                        <span>
                            @(asset.EpisodeId is null
                                ? "Shared media"
                                : "Episode media")
                        </span>

                        <span>
                            @asset.CreatedAtUtc.ToString("MMM d, yyyy")
                        </span>
                    </div>

                    @if (IsArtwork(asset))
                    {
                        <div class="mt-3">
                            <a class="btn btn-sm
                                btn-outline-primary"
                               href="@($"/media/{asset.Id:D}/artwork")">
                                Analyze artwork
                            </a>
                        </div>
                    }
                </div>
            </article>
        }

        <a class="media-tile placeholder-tile"
           href="/media/upload">
            <div>＋</div>
            <strong>Add source media</strong>
            <small>Upload another validated asset.</small>
        </a>
    </div>
}

@code {
    private IReadOnlyList<MediaAssetSummary> assets = [];
    private bool isLoading;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            AuthenticationState authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            string? ownerId =
                authenticationState.User
                    .FindFirst(
                        ClaimTypes.NameIdentifier)?
                    .Value;

            if (string.IsNullOrWhiteSpace(ownerId))
            {
                loadError =
                    "The authenticated user could not be resolved.";

                return;
            }

            assets = await MediaAssetService.ListAsync(ownerId);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load the Media Library.");

            loadError =
                "VibeCast could not load the Media Library.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetTypeCode(MediaAssetSummary asset)
    {
        var contentType = asset.ContentType.Trim().ToLowerInvariant();

        return contentType switch
        {
            "image/png" or "image/jpeg" => "IM",
            "audio/wav" or "audio/mpeg" or "audio/mp4" => "AU",
            "video/mp4" => "VI",
            "text/plain" => "TXT",
            "application/pdf" => "PDF",
            _ => "DOC"
        };
    }

    private static string GetPreviewClass(MediaAssetSummary asset)
    {
        var contentType = asset.ContentType.Trim().ToLowerInvariant();

        return contentType switch
        {
            "image/png" or "image/jpeg" => "preview-image",
            "audio/wav" or "audio/mpeg" or "audio/mp4" => "preview-audio",
            "video/mp4" => "preview-video",
            _ => "preview-document"
        };
    }

    private static string FormatSize(
        long bytes) =>
        bytes < 1_048_576
            ? $"{bytes / 1024d:N1} KB"
            : $"{bytes / 1_048_576d:N1} MB";

    private static bool IsArtwork(
      MediaAssetSummary asset) =>
        asset.ContentType.Equals(
        "image/png",
      StringComparison.OrdinalIgnoreCase) ||
        asset.ContentType.Equals(
        "image/jpeg",
      StringComparison.OrdinalIgnoreCase);
}
