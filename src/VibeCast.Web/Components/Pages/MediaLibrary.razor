@page "/media"
@attribute [Authorize]
@using System.Security.Claims
@using VibeCast.Application.Common
@using VibeCast.Domain.Media
@inject IMediaAssetService MediaAssetService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MediaLibrary> Logger

<PageTitle>Media library</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Content</div>
        <h1>Media library</h1>
        <p>
            Review uploaded media and choose which documents
            can participate in the VibeCast knowledge pipeline.
        </p>
    </div>

    <a class="btn btn-primary" href="/media/upload">
        Upload document
    </a>
</div>

<div class="surface-card filter-bar">
    <select class="form-select" @bind="selectedFilter">
        <option value="@MediaFilter.All">
            All media
        </option>
        <option value="@MediaFilter.General">
            General media
        </option>
        <option value="@MediaFilter.Knowledge">
            Knowledge sources
        </option>
    </select>
</div>

@if (isLoading)
{
    <section class="surface-card">
        <div class="empty-state compact">
            <div class="empty-icon">…</div>
            <div>
                <strong>Loading media</strong>
                <p>Retrieving your uploaded assets.</p>
            </div>
        </div>
    </section>
}
else
{
    <ErrorMessage Message="@loadError" />

    @if (string.IsNullOrWhiteSpace(loadError) && FilteredAssets.Count == 0)
    {
        <div class="empty-state large">
            <div class="empty-icon">＋</div>
            <div>
                <h2>No filtered media found</h2>
                <p>Try selecting a different filter or upload a new media file.</p>
                <a class="btn btn-primary" href="/media/upload">Upload media</a>
            </div>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(loadError))
    {
        <div class="media-card-grid mt-3">
            @foreach (MediaAssetSummary source in FilteredAssets)
            {
                <MediaAssetCard Asset="@source"
                                ContextLabel="Shared source"
                                Summary="Reusable research source available to VibeCast.">
                    <Actions Context="asset">
                        <div class="d-flex flex-column gap-2">

                            @if (MediaAssetHelpers.IsSupportedDocumentType(asset.ContentType))
                            {
                                <label class="form-check mb-0">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@asset.IsKnowledgeSource"
                                           disabled="@IsUpdating(asset.Id)"
                                           @onchange="args =>
                                               ToggleKnowledgeSourceAsync(
                                                   asset,
                                                   args)" />

                                    <span class="form-check-label">
                                        Use as knowledge source
                                    </span>

                                </label>
                            }

                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"/media/{asset.Id:D}/content")">
                                Open
                            </a>

                        </div>
                    </Actions>
                </MediaAssetCard>
            }
        </div>
    }
}

@code {
    private IReadOnlyList<MediaAssetSummary> sources = [];
    private readonly HashSet<Guid> updatingAssetIds = [];

    private string? ownerId;
    private bool isLoading;
    private string? loadError;
    private MediaFilter selectedFilter = MediaFilter.All;

    private IReadOnlyList<MediaAssetSummary> FilteredAssets => selectedFilter switch
    {
        MediaFilter.General =>
            sources
                .Where(asset => !asset.IsKnowledgeSource)
                .ToList(),

        MediaFilter.Knowledge =>
            sources
                .Where(asset => asset.IsKnowledgeSource)
                .ToList(),

        _ => sources
    };

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            AuthenticationState authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            ownerId = authenticationState.User
                .FindFirst(ClaimTypes.NameIdentifier)?
                .Value;

            if (string.IsNullOrWhiteSpace(ownerId))
            {
                loadError =
                    "The authenticated user could not be resolved. Sign in again and retry.";
                return;
            }

            sources = await MediaAssetService.ListAsync(ownerId);
        }
        catch (SafeApplicationException exception)
        {
            Logger.LogWarning(exception, "The Source Gallery query could not be completed.");
            loadError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the Source Gallery.");
            loadError = "VibeCast could not load the Source Gallery. Retry in a moment.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleKnowledgeSourceAsync(MediaAssetSummary asset, ChangeEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(ownerId))
        {
            return;
        }

        bool isKnowledgeSource = args.Value is bool value && value;

        updatingAssetIds.Add(asset.Id);
        loadError = null;

        try
        {
            await MediaAssetService.SetKnowledgeSourceAsync(
                asset.Id,
                isKnowledgeSource,
                ownerId);

            sources = sources.Select(current => current.Id == asset.Id
                        ? current with
                        {
                            IsKnowledgeSource = isKnowledgeSource
                        }
                        : current)
                .ToList();
        }
        catch (SafeApplicationException exception)
        {
            Logger.LogWarning(
                exception,
                "Could not change knowledge-source state for media asset {MediaAssetId}.",
                asset.Id);

            loadError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to change knowledge-source state for media asset {MediaAssetId}.",
                asset.Id);

            loadError =
                "VibeCast could not update the selected knowledge source.";
        }
        finally
        {
            updatingAssetIds.Remove(asset.Id);
        }
    }

    private bool IsUpdating(Guid assetId) => updatingAssetIds.Contains(assetId);

    private enum MediaFilter
    {
        All,
        General,
        Knowledge
    }
}
