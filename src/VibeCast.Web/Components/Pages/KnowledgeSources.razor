@page "/knowledge"
@attribute [Authorize]
@using System.Security.Claims
@using VibeCast.Application.Common
@using VibeCast.Application.Media
@using VibeCast.Domain.Media
@inject IMediaAssetService MediaAssetService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<KnowledgeSources> Logger

<PageTitle>Knowledge sources</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">AI operations</div>

        <h1>Knowledge sources</h1>

        <p>
            Review documents approved for the
            VibeCast knowledge pipeline.
        </p>
    </div>

    <a class="btn btn-outline-primary"
       href="/media">
        Manage media
    </a>
</div>

<section class="surface-card mt-3">
  <div class="table-responsive">
    <table class="table workspace-table mb-0">
        <thead>
            <tr>
                <th>Knowledge source</th>
                <th>Type</th>
                <th>Size</th>
                <th>Media status</th>
                <th>Knowledge status</th>
                <th>Added</th>
                <th></th>
            </tr>
        </thead>
      <tbody>
      @foreach (MediaAssetSummary source in sources)
      {
          <tr>
              <td>
                  <strong>
                      @source.OriginalFileName
                  </strong>
              </td>

              <td>
                  @MediaAssetHelpers.GetTypeCode(source.ContentType)
              </td>

              <td>
                  @MediaAssetHelpers.FormatSize(source.SizeBytes)
              </td>

              <td>
                  <span class="status-badge badge-info">
                      @source.Status
                  </span>
              </td>

              <td>
                  <span class="status-badge badge-warning">
                      Awaiting ingestion
                  </span>
              </td>

              <td>
                  @source.CreatedAtUtc.ToString("MMM d, yyyy")
              </td>

              <td>
                  <a class="btn btn-sm btn-outline-primary"
                      href="@($"/media/{source.Id:D}/content")">
                      Open
                  </a>
              </td>
          </tr>
      }
      </tbody>
    </table>
  </div>
</section>

<div class="architecture-callout mt-4">
    <div>
        <strong>Next: connect the knowledge corpus</strong>

        <p>
            Approved sources are now stored in the curated
            Azure Blob container. Next, connect that container
            to Foundry IQ for managed Azure AI Search ingestion.
        </p>
    </div>
</div>

@code {
    private IReadOnlyList<MediaAssetSummary> sources = [];
    private bool isLoading;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            AuthenticationState authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            string? ownerId =
                authenticationState.User
                    .FindFirst(ClaimTypes.NameIdentifier)?
                    .Value;

            if (string.IsNullOrWhiteSpace(ownerId))
            {
                loadError = "The authenticated user could not be resolved.";

                return;
            }

            sources = await MediaAssetService.ListKnowledgeSourcesAsync(ownerId);
        }
        catch (SafeApplicationException exception)
        {
            Logger.LogWarning(
                exception,
                "Could not load knowledge sources.");

            loadError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load knowledge sources.");

            loadError = "VibeCast could not load knowledge sources.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
