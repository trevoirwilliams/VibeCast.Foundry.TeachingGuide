@page "/knowledge"
@attribute [Authorize]
@using System.Security.Claims
@using VibeCast.Application.Common
@using VibeCast.Application.Knowledge
@using VibeCast.Application.Media
@using VibeCast.Domain.Media
@inject IMediaAssetService MediaAssetService
@inject IGroundedBlogGenerationService BlogGenerationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<KnowledgeSources> Logger

<PageTitle>Knowledge sources</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">AI operations</div>

        <h1>Knowledge sources</h1>

        <p>
            Review documents approved for the
            VibeCast knowledge pipeline.
        </p>
    </div>

    <a class="btn btn-outline-primary"
       href="/media">
        Manage media
    </a>
</div>

<section class="surface-card mt-3">
  <div class="table-responsive">
    <table class="table workspace-table mb-0">
        <thead>
            <tr>
                <th style="width: 48px;">Use</th>
                <th>Knowledge source</th>
                <th>Type</th>
                <th>Size</th>
                <th>Media status</th>
                <th>Added</th>
                <th></th>
            </tr>
        </thead>
      <tbody>
      @foreach (MediaAssetSummary source in sources)
      {
          <tr>
              <td>
                  <input class="form-check-input"
                          type="checkbox"
                          checked="@selectedSourceIds.Contains(source.Id)"
                          disabled="@isRetrieving"
                          @onchange="args => ToggleSource(source.Id, args)" />
              </td>
              <td>
                  <strong>
                      @source.OriginalFileName
                  </strong>
              </td>

              <td>
                  @MediaAssetHelpers.GetTypeCode(source.ContentType)
              </td>

              <td>
                  @MediaAssetHelpers.FormatSize(source.SizeBytes)
              </td>

              <td>
                  <span class="status-badge badge-info">
                      @source.Status
                  </span>
              </td>

              <td>
                  @source.CreatedAtUtc.ToString("MMM d, yyyy")
              </td>

              <td>
                  <a class="btn btn-sm btn-outline-primary"
                      href="@($"/media/{source.Id:D}/content")">
                      Open
                  </a>
              </td>
          </tr>
      }
      </tbody>
    </table>
  </div>
</section>

<section class="surface-card mt-4">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <div class="eyebrow">Grounded generation</div>
            <h2 class="h4 mb-1">Generate a blog</h2>
            <p class="text-muted mb-0">Enter a blog idea. VibeCast will retrieve relevant evidence from your approved knowledge sources.</p>
        </div>

        <span class="status-badge badge-info">@selectedSourceIds.Count knowledge source(s)</span>
    </div>

    <div class="mt-3">
        <label class="form-label" for="blog-prompt">Blog idea</label>
        <textarea id="blog-prompt" class="form-control" rows="4" maxlength="1000" disabled="@isGenerating" @bind="blogPrompt"></textarea>
        <div class="form-text">Describe the topic, question, or angle you want VibeCast to explore.</div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" disabled="@(!CanGenerate)" @onclick="GenerateBlogAsync">@(isGenerating ? "Generating blog..." : "Generate grounded blog")</button>
    </div>

    <ErrorMessage Message="@generationError" />
</section>

@if (generatedBlog is not null)
{
    <section class="surface-card mt-4">
        <div class="eyebrow">Generated blog</div>

        <h2 class="mt-2">@generatedBlog.Title</h2>

        @if (!string.IsNullOrWhiteSpace(generatedBlog.Subtitle))
        {
            <p class="lead">@generatedBlog.Subtitle</p>
        }

        <p class="text-muted">@generatedBlog.Summary</p>

        <hr />

        <p>@generatedBlog.Introduction</p>

        @foreach (GroundedBlogSection section in generatedBlog.Sections)
        {
            <h3 class="h5 mt-4">@section.Heading</h3>
            <p>@section.Body</p>
        }

        <h3 class="h5 mt-4">Conclusion</h3>
        <p>@generatedBlog.Conclusion</p>

        <h3 class="h5 mt-4">Key takeaways</h3>

        <ul>
            @foreach (string takeaway in generatedBlog.KeyTakeaways)
            {
                <li>@takeaway</li>
            }
        </ul>

        @if (generatedBlog.EvidenceReferences.Length > 0)
        {
            <div class="mt-3">
                @foreach (GroundedEvidenceReference reference in generatedBlog.EvidenceReferences)
                {
                    <div class="border rounded p-3 mb-2">
                        <div class="fw-semibold">
                            Evidence @reference.ReferenceId
                        </div>

                        <div class="text-muted small mt-1">
                            @reference.Snippet
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}
@code {
    private IReadOnlyList<MediaAssetSummary> sources = [];
    private bool isLoading;
    private string? loadError;

    private string? ownerId;

    private readonly HashSet<Guid> selectedSourceIds = [];

    private bool isRetrieving;

    private string? retrievalError;

    private bool isGenerating;
    private string? generationError;
    private GroundedBlogDraft? generatedBlog;
    private string blogPrompt = string.Empty;

    private bool CanGenerate => selectedSourceIds.Count > 0 && !isGenerating && !string.IsNullOrWhiteSpace(ownerId);

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            AuthenticationState authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            ownerId = authenticationState.User
                    .FindFirst(ClaimTypes.NameIdentifier)?
                    .Value;

            if (string.IsNullOrWhiteSpace(ownerId))
            {
                loadError = "The authenticated user could not be resolved.";

                return;
            }

            sources = await MediaAssetService.ListKnowledgeSourcesAsync(ownerId);
        }
        catch (SafeApplicationException exception)
        {
            Logger.LogWarning(exception, "Could not load knowledge sources.");

            loadError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load knowledge sources.");

            loadError = "VibeCast could not load knowledge sources.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleSource(Guid sourceId, ChangeEventArgs args)
    {
        bool selected = args.Value is bool value && value;

        if (selected)
        {
            selectedSourceIds.Add(sourceId);
        }
        else
        {
            selectedSourceIds.Remove(sourceId);
        }

        generatedBlog = null;
        generationError = null;
    }

    private async Task GenerateBlogAsync()
    {
        if (!CanGenerate)
        {
            return;
        }

        isGenerating = true;
        generatedBlog = null;
        generationError = null;

        try
        {
            GenerateGroundedBlogRequest request = new(blogPrompt.Trim());
            generatedBlog = await BlogGenerationService.GenerateAsync(request, ownerId);
        }
        catch (SafeApplicationException exception)
        {
            Logger.LogWarning(exception, "Grounded blog generation could not be completed.");
            generationError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Grounded blog generation failed.");
            generationError = "VibeCast could not generate a grounded blog.";
        }
        finally
        {
            isGenerating = false;
        }
    }
}
