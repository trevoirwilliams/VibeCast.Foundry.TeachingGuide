@page "/media/upload"
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using VibeCast.Application.Media
@using VibeCast.Application.Validation
@inject IMediaAssetService MediaAssetService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MediaUpload> Logger

<PageTitle>Upload media</PageTitle>

<div class="breadcrumb-line">
    <a href="/media">Media library</a>
    <span>/</span>
    <span>Upload media</span>
</div>

<div class="page-heading">
    <div>
        <div class="eyebrow">Safe media intake</div>
        <h1>Upload source media</h1>
        <p>
            Add an image, audio recording, video file, or production
            document to the VibeCast workspace.
        </p>
    </div>
</div>

<div class="upload-layout">
    <section class="surface-card upload-card">
        <div class="upload-dropzone">
            <InputFile OnChange="SelectFile"
                       accept=".png,.jpg,.jpeg,.wav,.mp3,.m4a,.mp4,.pdf,.txt"
                       disabled="@isUploading" />

            <div class="upload-icon">⇧</div>

            <h2>Choose one media file</h2>

            <p>
                PNG, JPEG, WAV, MP3, M4A, MP4, PDF, or TXT.
                Maximum size: 25 MB.
            </p>
        </div>

        @if (selectedFile is not null)
        {
            <div class="selected-file">
                <div class="file-icon">
                    @GetFileType(selectedFile.ContentType)
                </div>

                <div>
                    <strong>@selectedFile.Name</strong>

                    <small>
                        @(
                            string.IsNullOrWhiteSpace(selectedFile.ContentType)
                                ? "No reported content type"
                                : selectedFile.ContentType
                        )
                        · @FormatSize(selectedFile.Size)
                    </small>
                </div>

                <button class="btn btn-sm btn-outline-secondary"
                        type="button"
                        disabled="@isUploading"
                        @onclick="ClearFile">
                    Remove
                </button>
            </div>
        }

        @if (EpisodeId is Guid episodeId)
        {
            <div class="alert alert-info">
                This file will be associated with episode
                <code>@episodeId</code>.
            </div>
        }
        else
        {
            <div class="alert alert-secondary">
                This file will be added to the owner’s shared Media Library.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(uploadError))
        {
            <div class="alert alert-danger" role="alert">
                @uploadError
            </div>
        }

        @if (uploadResult is not null && !uploadResult.Succeeded)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Media rejected</strong>

                <ul class="mb-0 mt-2">
                    @foreach (ValidationFailure error in uploadResult.Errors)
                    {
                        <li>
                            <code>@error.PropertyName</code>: @error.ErrorMessage
                        </li>
                    }
                </ul>
            </div>
        }

        @if (uploadResult?.Asset is not null)
        {
            <div class="alert alert-success" role="status">
                <strong>Media accepted</strong>

                <div>
                    Asset <code>@uploadResult.Asset.Id</code> was stored as
                    <strong>@uploadResult.Asset.ContentType</strong>
                    and marked <strong>@uploadResult.Asset.Status</strong>.
                </div>

                @if (EpisodeId is Guid attachedEpisodeId)
                {
                    <a class="alert-link"
                       href="@($"/episodes/{attachedEpisodeId:D}")">
                        Return to the episode workspace
                    </a>
                }
                else
                {
                    <a class="alert-link" href="/media">
                        Open the Media Library
                    </a>
                }
            </div>
        }

        <div class="form-actions">
            <a class="btn btn-outline-secondary" href="@GetReturnUrl()">
                Cancel
            </a>

            <button class="btn btn-primary"
                    type="button"
                    disabled="@(selectedFile is null || isUploading)"
                    @onclick="UploadAsync">
                @(isUploading ? "Validating and storing..." : "Validate and upload")
            </button>
        </div>
    </section>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "episodeId")]
    public Guid? EpisodeId { get; set; }

    private IBrowserFile? selectedFile;
    private MediaUploadResult? uploadResult;
    private string? uploadError;
    private bool isUploading;
    private CancellationTokenSource? uploadCancellation;

    private void SelectFile(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        uploadResult = null;
        uploadError = null;
    }

    private void ClearFile()
    {
        selectedFile = null;
        uploadResult = null;
        uploadError = null;
    }

    private async Task UploadAsync()
    {
        if (selectedFile is null || isUploading)
        {
            return;
        }

        uploadResult = null;
        uploadError = null;
        isUploading = true;

        var currentCancellation = new CancellationTokenSource();
        uploadCancellation = currentCancellation;

        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var ownerId =
                authenticationState.User
                    .FindFirst(ClaimTypes.NameIdentifier)?
                    .Value;

            if (string.IsNullOrWhiteSpace(ownerId))
            {
                uploadError = "The authenticated user could not be resolved. Sign in again and retry.";
                return;
            }

            var request = new MediaUploadRequest(
                FileName: selectedFile.Name,
                ContentType: selectedFile.ContentType,
                SizeBytes: selectedFile.Size,
                EpisodeId: EpisodeId);

            await using var content = selectedFile.OpenReadStream(
                MediaUploadValidator.MaximumSizeBytes,
                currentCancellation.Token);

            uploadResult = await MediaAssetService.UploadAsync(
                request,
                content,
                ownerId,
                currentCancellation.Token);

            if (uploadResult.Succeeded)
            {
                selectedFile = null;
            }
        }
        catch (IOException exception)
        {
            Logger.LogWarning(
                exception,
                "The selected media exceeded the upload limit or the stream ended unexpectedly.");

            uploadError = exception.Message;
        }
        catch (OperationCanceledException) when (currentCancellation.IsCancellationRequested)
        {
            uploadError = "The media upload was cancelled.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Media intake failed.");

            uploadError = "VibeCast could not accept the file. Review the application logs and retry.";
        }
        finally
        {
            if (ReferenceEquals(uploadCancellation, currentCancellation))
            {
                uploadCancellation = null;
            }

            currentCancellation.Dispose();
            isUploading = false;
        }
    }

    private static string GetFileType(string contentType)
    {
        if (contentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase))
        {
            return "AU";
        }

        if (contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            return "IM";
        }

        if (contentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase))
        {
            return "VI";
        }

        if (contentType.StartsWith("text/", StringComparison.OrdinalIgnoreCase))
        {
            return "TX";
        }

        return "DOC";
    }

    private static string FormatSize(long bytes) =>
        bytes < 1_048_576
            ? $"{bytes / 1024d:N1} KB"
            : $"{bytes / 1_048_576d:N1} MB";

    public void Dispose()
    {
        CancellationTokenSource? cancellation = Interlocked.Exchange(ref uploadCancellation, null);
        cancellation?.Cancel();
        cancellation?.Dispose();
    }

    private string GetReturnUrl() =>
      EpisodeId is Guid episodeId
          ? $"/episodes/{episodeId:D}"
          : "/media";
}
