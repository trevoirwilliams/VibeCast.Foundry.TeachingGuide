@page "/episodes/{Id}"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using VibeCast.Application.Episodes
@using VibeCast.Application.Media
@using VibeCast.Application.Validation
@using VibeCast.Domain.Episodes
@using VibeCast.Domain.Media
@using VibeCast.Infrastructure.AI
@inject IEpisodeService EpisodeService
@inject IEpisodeArtworkGenerationService EpisodeArtworkGenerationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<EpisodeWorkspace> Logger

<PageTitle>
    @(episode is null ? "Episode workspace" : episode.Title)
</PageTitle>

@if (isLoading)
{
    <section class="surface-card">
        <div class="empty-state compact">
            <div class="empty-icon">…</div>
            <div>
                <strong>Loading episode workspace</strong>
                <p>Retrieving the persisted editorial brief.</p>
            </div>
        </div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <section class="surface-card">
        <div class="alert alert-danger mb-0" role="alert">
            @loadError
        </div>
    </section>
}
else if (episode is not null)
{
    <div class="breadcrumb-line">
        <a href="/episodes">Episodes</a>
        <span>/</span>
        <span>@episode.Title</span>
    </div>

    <div class="page-heading episode-heading">
        <div>
            <div class="eyebrow">
                Episode @episode.Id
            </div>

            <h1>@episode.Title</h1>

            <p>
                @(string.IsNullOrWhiteSpace(episode.Description)
                    ? "No episode description has been provided."
                    : episode.Description)
            </p>
        </div>

        <div class="page-actions">
            <span class="status-badge @GetStatusBadgeClass(episode.Status)">
                @GetStatusLabel(episode.Status)
            </span>

            <button class="btn btn-outline-secondary"
                    type="button"
                    disabled="@(
                    planningResult is null ||
                    planIsPersisted ||
                    isSavingPlan ||
                    isGeneratingPlan)"
                    @onclick="SaveAcceptedPlanAsync">
                @(isSavingPlan ? "Saving plan..."
                    : planIsPersisted ? "Plan saved" : "Save accepted plan")
            </button>

            <button class="btn btn-primary"
                    type="button"
                    disabled="@(isGeneratingPlan || episode is null)"
                    @onclick="GeneratePlanAsync">
                @(isGeneratingPlan ? "Generating plan..." : "Generate plan")
            </button>
        </div>
    </div>

    <div class="workspace-tabs" role="tablist">
        @foreach (string tab in tabs)
        {
            <button class="@(selectedTab == tab ? "active" : null)"
                    @onclick="() => selectedTab = tab">
                @tab
            </button>
        }
    </div>

    <section class="surface-card workspace-panel">
        @if (selectedTab == "Overview")
        {
            <div class="two-column-detail">
                <div>
                    <div class="section-heading">
                        <div>
                            <h2>Editorial brief</h2>
                            <p>
                                Persisted application inputs that will
                                constrain episode planning.
                            </p>
                        </div>

                        <button class="btn btn-sm btn-outline-secondary"
                                disabled>
                            Edit brief
                        </button>
                    </div>

                    <dl class="detail-grid">
                        <dt>Target audience</dt>
                        <dd>@episode.TargetAudience</dd>

                        <dt>Objective</dt>
                        <dd>@episode.Objective</dd>

                        <dt>Tone</dt>
                        <dd>@episode.Tone</dd>

                        <dt>Language</dt>
                        <dd>@episode.Language</dd>

                        <dt>Publication</dt>
                        <dd>
                            @FormatPublicationDate(
                                episode.PlannedPublishDate)
                        </dd>
                    </dl>
                </div>

                <aside class="readiness-panel">
                    <div class="readiness-icon">AI</div>
                    <h3>Editorial brief ready</h3>
                    <p>
                        The episode context is persisted and ready
                        for the structured AI Planner.
                    </p>
                    <small>
                        Planning is implemented in the next lesson.
                    </small>
                </aside>
            </div>
        }
        else if (selectedTab == "AI Planner")
        {
            @if (!string.IsNullOrWhiteSpace(planSaveError))
            {
                <div class="alert alert-danger" role="alert">
                    @planSaveError
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(planSaveMessage))
            {
                <div class="alert alert-success" role="status">
                    @planSaveMessage
                </div>
            }

            @if (isGeneratingPlan)
            {
                <div class="empty-state large">
                    <div class="empty-icon">…</div>
                    <div>
                        <h2>Generating a structured episode plan</h2>
                        <p>
                            Microsoft Foundry is mapping the persisted brief
                            into the VibeCast planning contract.
                        </p>

                        <button class="btn btn-outline-secondary"
                                type="button"
                                @onclick="CancelPlanGeneration">
                            Stop generation
                        </button>
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(planError))
            {
                <div class="alert alert-danger" role="alert">
                    <strong>@planError</strong>

                    @if (planValidationFailures.Count > 0)
                    {
                        <ul class="mb-0 mt-2">
                            @foreach (
                                ValidationFailure failure
                                in planValidationFailures)
                            {
                                <li>
                                    <code>@failure.PropertyName</code>:
                                    @failure.ErrorMessage
                                </li>
                            }
                        </ul>
                    }
                </div>

                <button class="btn btn-primary"
                        type="button"
                        @onclick="GeneratePlanAsync">
                    Generate a new plan
                </button>
            }
            else if (planningResult is not null)
            {
                @if (planIsPersisted)
                {
                    <div class="alert alert-info" role="status">
                        <strong>Saved episode plan</strong>

                        <div>
                            This accepted plan is persisted with the episode
                            and will be restored when the workspace reloads.
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" role="status">
                        <strong>Accepted but not saved</strong>

                        <div>
                            Save this plan before refreshing or leaving
                            the workspace.
                        </div>
                    </div>
                }

                <EpisodePlanPanel Result="planningResult" />
            }
            else
            {
                <div class="empty-state large">
                    <div class="empty-icon">✦</div>
                    <div>
                        <h2>Generate a structured episode plan</h2>
                        <p>
                            Convert the persisted editorial brief into
                            segments, messages, evidence needs, media
                            requirements, and editorial risks.
                        </p>

                        <button class="btn btn-primary"
                                type="button"
                                @onclick="GeneratePlanAsync">
                            Generate plan
                        </button>

                        <small>
                            The generated candidate is not persisted yet.
                        </small>
                    </div>
                </div>
            }
        }
        else if (selectedTab == "Transcript")
        {
            <div class="split-panel">
                <div>
                    <h2>Transcript workspace</h2>
                    <p>
                        Review source audio, speaker segments,
                        timestamps, and corrected text.
                    </p>

                    <div class="empty-state compact">
                        <div class="empty-icon">Aa</div>
                        <div>
                            <strong>No transcript yet</strong>
                            <p>
                                Speech processing is implemented in
                                the multimodal section.
                            </p>
                        </div>
                    </div>
                </div>

                <aside class="panel-muted">
                    <h3>Transcript controls</h3>

                    <label class="form-label">Language</label>
                    <select class="form-select" disabled>
                        <option>@episode.Language</option>
                    </select>

                    <label class="form-label mt-3">
                        Speaker identification
                    </label>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               disabled />

                        <label class="form-check-label">
                            Detect speakers
                        </label>
                    </div>
                </aside>
            </div>
        }
        else if (selectedTab == "Media")
        {
            <div class="section-heading">
                <div>
                    <h2>Episode media</h2>
                    <p>
                        Related audio, images, documents, and
                        generated promotional assets.
                    </p>
                </div>

                @if (episode.AcceptedPlan is null)
                {
                    <div class="alert alert-warning" role="status">
                        Save an accepted episode plan before generating
                        promotional artwork.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(
                        artworkGenerationError))
                {
                    <div class="alert alert-danger" role="alert">
                        @artworkGenerationError
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(
                        artworkGenerationMessage))
                {
                    <div class="alert alert-success" role="status">
                        @artworkGenerationMessage
                    </div>
                }

                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm btn-primary"
                            type="button"
                            disabled="@(isGeneratingArtwork || episode.AcceptedPlan is null)"
                            @onclick="GeneratePromotionalArtworkAsync">
                        @(isGeneratingArtwork
                            ? "Generating artwork..."
                            : "Generate promotional artwork")
                    </button>

                    <a class="btn btn-sm btn-outline-primary"
                       href="@($"/media/upload?episodeId={episode.Id:D}")">
                        Add media
                    </a>
                </div>
            </div>

            @if (episode.MediaAssets.Count == 0)
            {
                <div class="empty-state compact">
                    <a class="media-tile placeholder-tile" href="@($"/media/upload?episodeId={episode.Id:D}")">
                        <div>＋</div>
                        <strong>Add source media</strong>
                        <small>Upload another validated asset.</small>
                    </a>

                    <div>
                        <strong>No media assets yet</strong>
                        <p>
                            Upload source files or artwork tied to this episode.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="media-card-grid">
                    @foreach (MediaAssetSummary asset in episode.MediaAssets)
                    {
                        <article class="media-tile">
                            @if (MediaAssetHelpers.IsArtwork(asset.ContentType))
                            {
                                <div class="media-preview preview-image">
                                    <img src="@($"/media/{asset.Id:D}/content")"
                                         alt=""
                                         loading="lazy" />
                                </div>
                            }
                            else
                            {
                                <div class="media-preview @MediaAssetHelpers.GetPreviewClass(asset.ContentType)">
                                    <span>
                                        @MediaAssetHelpers.GetTypeCode(
                                            asset.ContentType)
                                    </span>
                                </div>
                            }

                            <div class="media-copy">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong>@asset.OriginalFileName</strong>

                                    <span class="status-badge badge-info">
                                        @asset.Status
                                    </span>
                                </div>

                                <small>
                                    @asset.ContentType · @MediaAssetHelpers.FormatSize(asset.SizeBytes)
                                </small>

                                <p>
                                    @MediaAssetHelpers.GetMediaSummary(asset.ContentType)
                                </p>

                                <div class="media-meta">
                                    <span>
                                        Attached to this episode
                                    </span>

                                    <span>
                                        @asset.CreatedAtUtc.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
                                    </span>
                                </div>

                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@($"/media/{asset.Id:D}/content")">
                                        Open file
                                    </a>

                                    @if (MediaAssetHelpers.IsArtwork(asset.ContentType))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary"
                                           href="@($"/media/{asset.Id:D}/artwork")">
                                            Review artwork
                                        </a>
                                    }
                                </div>
                            </div>
                        </article>
                    }


                </div>
            }
        }
        else if (selectedTab == "Knowledge")
        {
            <div class="section-heading">
                <div>
                    <h2>Grounding evidence</h2>
                    <p>
                        Choose permission-aware sources that support
                        generated claims.
                    </p>
                </div>

                <a class="btn btn-sm btn-outline-primary"
                   href="/knowledge">
                    Manage sources
                </a>
            </div>

            <div class="empty-state compact">
                <div class="empty-icon">◇</div>
                <div>
                    <strong>No knowledge source attached</strong>
                    <p>
                        RAG ingestion and citations are implemented
                        in Section 07.
                    </p>
                </div>
            </div>
        }
        else if (selectedTab == "Workflow")
        {
            <h2>Editorial workflow</h2>
            <p>
                Track deterministic stages, specialist agents,
                approvals, and resumable execution.
            </p>

            <div class="workflow-strip">
                <div class="complete">
                    <span>1</span>
                    <strong>Brief</strong>
                    <small>Ready</small>
                </div>
                <i></i>
                <div>
                    <span>2</span>
                    <strong>Research</strong>
                    <small>Not started</small>
                </div>
                <i></i>
                <div>
                    <span>3</span>
                    <strong>Draft</strong>
                    <small>Not started</small>
                </div>
                <i></i>
                <div>
                    <span>4</span>
                    <strong>Approval</strong>
                    <small>Not started</small>
                </div>
            </div>
        }
        else
        {
            <div class="section-heading">
                <div>
                    <h2>Evaluation evidence</h2>
                    <p>
                        Quality, groundedness, safety, and regression
                        results for this episode.
                    </p>
                </div>

                <a class="btn btn-sm btn-outline-primary"
                   href="/evaluations">
                    Open evaluations
                </a>
            </div>

            <div class="metric-grid compact">
                <div class="metric-card">
                    <div class="metric-label">Quality</div>
                    <div class="metric-value">—</div>
                    <div class="metric-note">No evaluation run</div>
                </div>

                <div class="metric-card">
                    <div class="metric-label">Groundedness</div>
                    <div class="metric-value">—</div>
                    <div class="metric-note">
                        No evidence generated
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-label">Safety</div>
                    <div class="metric-value">—</div>
                    <div class="metric-note">
                        Guardrails not configured
                    </div>
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [Inject(Key = EpisodePlanningServiceKeys.WithTools)]
    public IEpisodePlanningService EpisodePlanningService { get; set; } = default!;

    private static readonly string[] tabs =
    [
        "Overview",
        "AI Planner",
        "Transcript",
        "Media",
        "Knowledge",
        "Workflow",
        "Evaluation"
    ];

    private EpisodeDetails? episode;
    private string selectedTab = "Overview";
    private string? loadError;
    private bool isLoading;
    private EpisodePlanningResult? planningResult;
    private string? planError;
    private bool isGeneratingPlan;
    private CancellationTokenSource? planningCancellation;
    private CancellationTokenSource? artworkGenerationCancellation;
    private IReadOnlyList<ValidationFailure> planValidationFailures = [];
    private string? currentOwnerId;

    private bool planIsPersisted;

    private bool isSavingPlan;

    private string? planSaveMessage;

    private string? planSaveError;
    private bool isGeneratingArtwork;
    private string? artworkGenerationError;
    private string? artworkGenerationMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadEpisodeAsync();
    }

    private async Task LoadEpisodeAsync()
    {
        episode = null;
        loadError = null;
        isLoading = true;

        try
        {
            if (!Guid.TryParse(Id, out Guid episodeId))
            {
                loadError =
                    "The requested episode identifier is invalid.";

                return;
            }

            AuthenticationState authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            string? ownerId = authenticationState.User
                .FindFirst(ClaimTypes.NameIdentifier)?
                .Value;

            if (string.IsNullOrWhiteSpace(ownerId))
            {
                loadError =
                    "The authenticated user could not be resolved.";

                return;
            }

            currentOwnerId = ownerId;

            episode = await EpisodeService.GetAsync(
                episodeId,
                ownerId);

            if (episode is null)
            {
                loadError =
                    "The episode could not be found or is not " +
                    "available to the current user.";
            }

            planningResult = episode?.AcceptedPlan;

            planIsPersisted = planningResult is not null;
        }
        catch
        {
            loadError =
                "VibeCast could not load the episode workspace.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatPublicationDate(DateOnly? date)
    {
        return date?.ToString(
                   "MMMM d, yyyy",
                   CultureInfo.InvariantCulture)
               ?? "Not scheduled";
    }

    private static string GetStatusLabel(EpisodeStatus status)
    {
        return status switch
        {
            EpisodeStatus.ReadyForReview => "Ready for review",
            _ => status.ToString()
        };
    }

    private static string GetStatusBadgeClass(EpisodeStatus status)
    {
        return status switch
        {
            EpisodeStatus.Draft => "badge-neutral",
            EpisodeStatus.Planning => "badge-info",
            EpisodeStatus.ReadyForReview => "badge-warning",
            EpisodeStatus.Published => "badge-success",
            EpisodeStatus.Archived => "badge-neutral",
            _ => "badge-neutral"
        };
    }

    private async Task GeneratePlanAsync()
    {
        if (episode is null || isGeneratingPlan)
        {
            return;
        }

        selectedTab = "AI Planner";
        planError = null;
        planningResult = null;
        planValidationFailures = [];
        planSaveMessage = null;
        planSaveError = null;

        planningCancellation?.Cancel();
        planningCancellation?.Dispose();

        CancellationTokenSource currentCancellation =
            new(TimeSpan.FromSeconds(90));

        planningCancellation = currentCancellation;
        isGeneratingPlan = true;

        try
        {
            GenerateEpisodePlanRequest request = new(
                EpisodeId: episode.Id,
                Title: episode.Title,
                Description: episode.Description,
                TargetAudience: episode.TargetAudience,
                Objective: episode.Objective,
                Tone: episode.Tone,
                Language: episode.Language,
                PlannedPublishDate: episode.PlannedPublishDate);

            planningResult =
                await EpisodePlanningService.GenerateAsync(
                    request,
                    currentCancellation.Token);
            planIsPersisted = false;
        }
        catch (OperationCanceledException)
            when (currentCancellation.IsCancellationRequested)
        {
            planError =
                "Episode planning was cancelled or exceeded " +
                "the 90-second time limit.";
        }
        catch (EpisodePlanValidationException exception)
        {
            planValidationFailures = exception.Failures;

            planError =
                "VibeCast rejected the generated episode plan after " +
                "one bounded repair attempt.";

            Logger.LogWarning(
                "Episode plan generation ended with {FailureCount} " +
                "deterministic validation failure(s) for episode " +
                "{EpisodeId}.",
                exception.Failures.Count,
                episode.Id);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to generate a typed episode plan for " +
                "episode {EpisodeId}.",
                episode.Id);

            planError =
                "VibeCast could not generate a typed episode plan. " +
                "Verify the Foundry model configuration and retry.";
        }
        finally
        {
            if (ReferenceEquals(
                    planningCancellation,
                    currentCancellation))
            {
                planningCancellation = null;
            }

            currentCancellation.Dispose();
            isGeneratingPlan = false;
        }
    }

    private void CancelPlanGeneration()
    {
        planningCancellation?.Cancel();
    }

    private async Task SaveAcceptedPlanAsync()
    {
        if (episode is null || planningResult is null || string.IsNullOrWhiteSpace(currentOwnerId) ||
          planIsPersisted || isSavingPlan)
        {
            return;
        }

        planSaveMessage = null;
        planSaveError = null;
        isSavingPlan = true;

        try
        {
            await EpisodeService.SavePlanAsync(
                episode.Id,
                currentOwnerId,
                planningResult);

            planIsPersisted = true;

            planSaveMessage =
                "The accepted episode plan was saved.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to save the accepted episode plan for " +
                "episode {EpisodeId}.",
                episode.Id);

            planSaveError =
                "VibeCast could not save the accepted episode plan.";
        }
        finally
        {
            isSavingPlan = false;
        }
    }

    private async Task GeneratePromotionalArtworkAsync()
    {
        if (episode is null || episode.AcceptedPlan is null || string.IsNullOrWhiteSpace(currentOwnerId)
          || isGeneratingArtwork)
        {
            return;
        }

        selectedTab = "Media";
        artworkGenerationMessage = null;
        artworkGenerationError = null;

        artworkGenerationCancellation?.Cancel();
        artworkGenerationCancellation?.Dispose();

        CancellationTokenSource currentCancellation = new(TimeSpan.FromSeconds(90));
        artworkGenerationCancellation = currentCancellation;

        isGeneratingArtwork = true;

        try
        {
            await EpisodeArtworkGenerationService
                .GenerateAsync(
                    episode.Id,
                    currentOwnerId,
                    currentCancellation.Token);

            await LoadEpisodeAsync();

            selectedTab = "Media";

            artworkGenerationMessage =
                "Promotional artwork was generated and " +
                "added to this episode.";
        }
        catch (OperationCanceledException)
            when (currentCancellation.IsCancellationRequested)
        {
            artworkGenerationError =
                "Artwork generation was cancelled or exceeded " +
                "the 90-second time limit.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to generate promotional artwork " +
                "for episode {EpisodeId}.",
                episode.Id);

            artworkGenerationError =
                "VibeCast could not generate promotional artwork. " +
                "Verify the image model configuration and retry.";
        }
        finally
        {
            if (ReferenceEquals(
                    artworkGenerationCancellation,
                    currentCancellation))
            {
                artworkGenerationCancellation = null;
            }

            currentCancellation.Dispose();
            isGeneratingArtwork = false;
        }
    }

    public void Dispose()
    {
        CancellationTokenSource? planning =
            Interlocked.Exchange(
                ref planningCancellation,
                null);

        planning?.Cancel();
        planning?.Dispose();

        CancellationTokenSource? artwork =
            Interlocked.Exchange(
                ref artworkGenerationCancellation,
                null);

        artwork?.Cancel();
        artwork?.Dispose();
    }
}
