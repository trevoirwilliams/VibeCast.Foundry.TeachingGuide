    public void Dispose()
    {
        CancellationTokenSource? planning =
            Interlocked.Exchange(
                ref planningCancellation,
                null);

        planning?.Cancel();
        planning?.Dispose();

        CancellationTokenSource? artwork =
            Interlocked.Exchange(
                ref artworkGenerationCancellation,
                null);

        artwork?.Cancel();
        artwork?.Dispose();

        CancellationTokenSource? transcription = Interlocked.Exchange(
        ref transcriptionCancellation,
        null);

        transcription?.Cancel();
        transcription?.Dispose();

        CancellationTokenSource? resourceAnalysis = Interlocked.Exchange(
        ref resourceAnalysisCancellation,
        null);

        resourceAnalysis?.Cancel();
        resourceAnalysis?.Dispose();
    }

    private async Task TranscribeSelectedRecordingAsync()
    {
        if (episode is null || SelectedAudioAsset is null || string.IsNullOrWhiteSpace(currentOwnerId)
          || isTranscribing)
        {
            return;
        }


        MediaAssetSummary source = SelectedAudioAsset;

        selectedTab = "Transcript";

        transcriptionError = null;
        transcriptionMessage = null;

        transcriptionCancellation?.Cancel();
        transcriptionCancellation?.Dispose();

        CancellationTokenSource currentCancellation = new(TimeSpan.FromMinutes(2));
        transcriptionCancellation = currentCancellation;

        isTranscribing = true;

        try
        {
            await EpisodeTranscriptionService.TranscribeAsync(
                    source.Id,
                    currentOwnerId,
                    currentCancellation.Token);

            await LoadEpisodeAsync();

            selectedTab = "Transcript";

            selectedTranscriptionMediaAssetId = source.Id;

            transcriptionMessage =
                "The episode recording was transcribed " +
                "and the transcript was saved.";
        }
        catch (OperationCanceledException)
            when (currentCancellation.IsCancellationRequested)
        {
            transcriptionError =
                "Transcription was cancelled or exceeded " +
                "the two-minute time limit.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to transcribe media asset " +
                "{MediaAssetId} for episode {EpisodeId}.",
                source.Id,
                episode.Id);

            transcriptionError =
                "VibeCast could not transcribe the selected " +
                "recording. Verify the Speech configuration " +
                "and retry.";
        }
        finally
        {
            if (ReferenceEquals(
                    transcriptionCancellation,
                    currentCancellation))
            {
                transcriptionCancellation = null;
            }

            currentCancellation.Dispose();

            isTranscribing = false;
        }
    }

    private void CancelTranscription()
    {
        transcriptionCancellation?.Cancel();
    }

    private void SelectTranscriptionSource(ChangeEventArgs args)
    {
        transcriptionMessage = null;
        transcriptionError = null;

        selectedTranscriptionMediaAssetId =
            Guid.TryParse(
                args.Value?.ToString(),
                out Guid mediaAssetId)
                ? mediaAssetId
                : null;
    }

    private async Task AnalyzeSupportingResourceAsync(MediaAssetSummary asset)
    {
        if (episode is null || episode.AcceptedPlan is null || string.IsNullOrWhiteSpace(currentOwnerId) ||analyzingResourceId.HasValue)
        {
            return;
        }

        selectedTab = "Media";

        resourceAnalysisMessage = null;
        resourceAnalysisError = null;

        resourceAnalysisCancellation?.Cancel();
        resourceAnalysisCancellation?.Dispose();

        CancellationTokenSource currentCancellation = new(TimeSpan.FromMinutes(2));

        resourceAnalysisCancellation = currentCancellation;
        analyzingResourceId = asset.Id;

        try
        {
            EpisodeResourceAnalysisResult result =
                await EpisodeResourceAnalysisService
                    .AnalyzeAsync(
                        episode.Id,
                        asset.Id,
                        currentOwnerId,
                        currentCancellation.Token);

            await LoadEpisodeAsync();

            selectedTab = "Media";

            resourceAnalysisMessage = result.Message;
        }
        catch (OperationCanceledException) when (currentCancellation.IsCancellationRequested)
        {
            resourceAnalysisError = "Resource analysis was cancelled or exceeded the two-minute time limit.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to assess supporting resource " +
                "{MediaAssetId} for episode {EpisodeId}.",
                asset.Id,
                episode.Id);

            resourceAnalysisError =
                "VibeCast could not assess this resource. " +
                "Verify the Content Understanding and " +
                "Foundry configuration, then retry.";
        }
        finally
        {
            if (ReferenceEquals(
                    resourceAnalysisCancellation,
                    currentCancellation))
            {
                resourceAnalysisCancellation =
                    null;
            }

            currentCancellation.Dispose();

            analyzingResourceId = null;
        }
    }
