@using System.Globalization
@using VibeCast.Application.Episodes

<section class="panel-muted mt-4">
    <div class="section-heading">
        <div>
            <div class="eyebrow">
                Episode evidence
            </div>

            <h2>Supporting sources</h2>

            <p class="mb-0">
                Resources assessed as materially useful
                to the accepted episode plan.
            </p>
        </div>

        <span class="status-badge badge-info">
            @Sources.Count source@(Sources.Count == 1 ? "" : "s")
        </span>
    </div>

    @if (Sources.Count == 0)
    {
        <div class="empty-state compact">
            <div class="empty-icon">◇</div>

            <div>
                <strong>No supporting sources yet</strong>

                <p>
                    Open the Media tab and assess an
                    attached PDF or text resource.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="d-grid gap-3">
            @foreach (EpisodeSupportingSourceSummary source in Sources)
            {
                <article class="supporting-source-card">
                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        gap-3">
                        <div>
                            <strong>
                                @source.SourceFileName
                            </strong>

                            <small class="d-block text-muted">
                                @source.ContentType
                            </small>
                        </div>

                        <span class="status-badge badge-success">
                            Relevant
                        </span>
                    </div>

                    <p class="mt-3 mb-3">
                        @source.Summary
                    </p>

                    @if (source.RelevantPoints.Count > 0)
                    {
                        <strong>Useful points</strong>

                        <ul class="mb-3">
                            @foreach (string point in source.RelevantPoints)
                            {
                                <li>@point</li>
                            }
                        </ul>
                    }

                    @if (source.MatchedEvidenceRequirements.Count > 0)
                    {
                        <strong>
                            Supports evidence requirements
                        </strong>

                        <ul class="mb-3">
                            @foreach (string requirement in source.MatchedEvidenceRequirements)
                            {
                                <li>@requirement</li>
                            }
                        </ul>
                    }

                    <div class="media-meta">
                        <span>
                            Analyzed @source.AnalyzedAtUtc.ToString(
                            "MMM d, yyyy",
                            CultureInfo.InvariantCulture)
                        </span>

                        <span>
                            @source.AnalyzerId
                        </span>
                    </div>

                    <div class="mt-3">
                        <a class="btn btn-sm
                            btn-outline-primary"
                           target="_blank"
                           href="@($"/media/{source.MediaAssetId:D}/content")">
                            Open cited file
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<EpisodeSupportingSourceSummary> Sources { get; set; } = [];
}
