@page "/episodes/new"
@page "/episodes/create"
@attribute [Authorize]

<PageTitle>Create episode</PageTitle>

<div class="breadcrumb-line"><a href="/dashboard">Dashboard</a><span>/</span><span>Create episode</span></div>
<div class="page-heading">
  <div>
    <div class="eyebrow">Editorial brief</div>
    <h1>Create an episode</h1>
    <p>Define the business and editorial context that the AI client will use to generate an initial episode concept.</p>
  </div>
</div>

<div class="form-layout">
  <section class="surface-card">
    <EditForm Model="model" OnValidSubmit="PreviewSubmission" FormName="create-episode-shell">
      <DataAnnotationsValidator />
      <ValidationSummary class="text-danger" />

      <div class="form-section">
        <div class="form-section-title"><span>1</span><div><h2>Episode identity</h2><p>Give the workspace a clear editorial purpose.</p></div></div>
        <div class="mb-3">
          <label class="form-label">Episode title</label>
          <InputText class="form-control" @bind-Value="model.Title" placeholder="Example: Responsible AI in Production" />
          <ValidationMessage For="() => model.Title" />
        </div>
        <div class="mb-3">
          <label class="form-label">Description</label>
          <InputTextArea class="form-control" rows="4" @bind-Value="model.Description" placeholder="Summarize the subject, intended value, and boundaries." />
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title"><span>2</span><div><h2>Audience and outcome</h2><p>These fields become the application-owned prompt inputs.</p></div></div>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Target audience</label><InputText class="form-control" @bind-Value="model.TargetAudience" placeholder="Enterprise .NET developers" /></div>
          <div class="col-md-6"><label class="form-label">Preferred tone</label><InputSelect class="form-select" @bind-Value="model.Tone"><option>Professional and direct</option><option>Conversational</option><option>Executive briefing</option><option>Technical deep dive</option></InputSelect></div>
          <div class="col-12"><label class="form-label">Content objective</label><InputTextArea class="form-control" rows="3" @bind-Value="model.Objective" placeholder="What should the audience understand or be able to do?" /></div>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title"><span>3</span><div><h2>Content language</h2><p>Select the language for the generated concept.</p></div></div>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Language</label><InputSelect class="form-select" @bind-Value="model.Language"><option>English (United States)</option><option>English (United Kingdom)</option><option>Spanish</option><option>French</option></InputSelect></div>
        </div>
      </div>

      @if (showNotice)
      {
        <div class="alert alert-info">The brief is valid and ready for the AI client implementation.</div>
      }

      <div class="form-actions">
        <a class="btn btn-outline-secondary" href="/dashboard">Cancel</a>
        <button class="btn btn-primary" type="submit">Validate brief</button>
      </div>
    </EditForm>
  </section>

  <aside class="surface-card guidance-card">
    <div class="guidance-icon">AI</div>
    <h2>AI concept seam</h2>
    <p>The episode brief will be passed to an application-owned concept generator using:</p>
    <ul>
      <li><code>IChatClient</code></li>
      <li><code>IEpisodeConceptGenerator</code></li>
      <li>Versioned prompt instructions</li>
      <li>Streaming and cancellation</li>
    </ul>
  </aside>
</div>

@code {
  private readonly EpisodeFormModel model = new();
  private bool showNotice;

  private void PreviewSubmission() => showNotice = true;

  private sealed class EpisodeFormModel
  {
    [System.ComponentModel.DataAnnotations.Required]
    [System.ComponentModel.DataAnnotations.StringLength(160, MinimumLength = 5)]
    public string Title { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public string TargetAudience { get; set; } = string.Empty;
    public string Objective { get; set; } = string.Empty;
    public string Tone { get; set; } = "Professional and direct";
    public string Language { get; set; } = "English (United States)";
  }
}
