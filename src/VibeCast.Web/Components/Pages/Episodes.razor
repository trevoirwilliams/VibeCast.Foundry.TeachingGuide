@page "/episodes"
@attribute [Authorize]
@using System.Security.Claims
@using VibeCast.Application.Episodes
@using VibeCast.Domain.Episodes
@inject IEpisodeService EpisodeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Episodes> Logger

<PageTitle>Episodes</PageTitle>

<div class="page-heading">
  <div>
    <div class="eyebrow">Content</div>
    <h1>Episodes</h1>
    <p>Open an editorial workspace or create a new episode brief.</p>
  </div>
  <a class="btn btn-primary" href="/episodes/create">Create episode</a>
</div>

@if (isLoading)
{
  <section class="surface-card"><p class="mb-0">Loading your episodes...</p></section>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
  <div class="alert alert-danger" role="alert">@loadError</div>
}
else if (episodes.Count == 0)
{
  <div class="empty-state large">
    <div class="empty-icon">＋</div>
    <div>
      <h2>No episodes yet</h2>
      <p>Create an editorial brief to start a new episode workspace.</p>
      <a class="btn btn-primary" href="/episodes/create">Create episode</a>
    </div>
  </div>
}
else
{
  <section class="surface-card">
    <div class="table-responsive">
      <table class="table workspace-table mb-0">
        <thead>
          <tr><th>Episode</th><th>Status</th><th>Last updated</th><th></th></tr>
        </thead>
        <tbody>
          @foreach (EpisodeSummary episode in episodes)
          {
            <tr>
              <td>
                <a class="table-link" href="@($"/episodes/{episode.Id:D}")">@episode.Title</a>
                <small>@GetSupportingText(episode)</small>
              </td>
              <td><span class="status-badge @GetStatusBadgeClass(episode.Status)">@GetStatusLabel(episode.Status)</span></td>
              <td>@episode.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
              <td><a class="btn btn-sm btn-outline-secondary" href="@($"/episodes/{episode.Id:D}")">Open workspace</a></td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
}

@code {
  private IReadOnlyList<EpisodeSummary> episodes = [];
  private bool isLoading = true;
  private string? loadError;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      AuthenticationState authenticationState =
        await AuthenticationStateProvider.GetAuthenticationStateAsync();

      string? ownerId = authenticationState.User
        .FindFirst(ClaimTypes.NameIdentifier)?.Value;

      if (string.IsNullOrWhiteSpace(ownerId))
      {
        loadError = "The authenticated user could not be resolved. Sign in again and retry.";
        return;
      }

      episodes = await EpisodeService.ListAsync(ownerId);
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "Failed to load episodes.");
      loadError = "VibeCast could not load your episodes. Retry in a moment.";
    }
    finally
    {
      isLoading = false;
    }
  }

  private static string GetSupportingText(EpisodeSummary episode) =>
    string.IsNullOrWhiteSpace(episode.Description)
      ? episode.TargetAudience
      : episode.Description;

  private static string GetStatusLabel(EpisodeStatus status) =>
    status == EpisodeStatus.ReadyForReview ? "Ready for review" : status.ToString();

  private static string GetStatusBadgeClass(EpisodeStatus status) =>
    status switch
    {
      EpisodeStatus.Draft => "badge-neutral",
      EpisodeStatus.Planning => "badge-info",
      EpisodeStatus.ReadyForReview => "badge-warning",
      EpisodeStatus.Published => "badge-success",
      EpisodeStatus.Archived => "badge-neutral",
      _ => "badge-neutral"
    };
}
