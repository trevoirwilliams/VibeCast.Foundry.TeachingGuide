@page "/episodes"
@attribute [Authorize]
@using System.Security.Claims
@using VibeCast.Application.Common
@inject IEpisodeService EpisodeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Episodes> Logger

<PageTitle>Episodes</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Content</div>
        <h1>Episodes</h1>
        <p>Open an editorial workspace or create a new episode brief.</p>
    </div>
    <a class="btn btn-primary" href="/episodes/create">Create episode</a>
</div>

@if (isLoading)
{
    <section class="surface-card">
        <div class="empty-state compact">
            <div class="empty-icon">…</div>
            <div>
                <strong>Loading episodes</strong>
                <p>Retrieving your editorial workspaces.</p>
            </div>
        </div>
    </section>
}
else
{
    <ErrorMessage Message="@loadError" />

    @if (string.IsNullOrWhiteSpace(loadError) && episodes.Count == 0)
    {
        <div class="empty-state large">
            <div class="empty-icon">＋</div>
            <div>
                <h2>No episodes yet</h2>
                <p>Create an editorial brief to start a new episode workspace.</p>
                <a class="btn btn-primary" href="/episodes/create">Create episode</a>
            </div>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(loadError))
    {
        <section class="surface-card">
            <div class="table-responsive">
                <table class="table workspace-table mb-0">
                    <thead>
                        <tr>
                            <th>Episode</th>
                            <th>Status</th>
                            <th>Last updated</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (EpisodeSummary episode in episodes)
                        {
                            <tr>
                                <td>
                                    <a class="table-link" href="@($"/episodes/{episode.Id:D}")">
                                        @episode.Title
                                    </a>
                                    <small>@GetSupportingText(episode)</small>
                                </td>
                                <td><EpisodeStatusBadge Status="@episode.Status" /></td>
                                <td>@FormatUpdatedAt(episode.UpdatedAtUtc)</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-secondary"
                                       href="@($"/episodes/{episode.Id:D}")">
                                        Open workspace
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@code {
    private IReadOnlyList<EpisodeSummary> episodes = [];
    private bool isLoading;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            AuthenticationState authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            string? ownerId = authenticationState.User
                .FindFirst(ClaimTypes.NameIdentifier)?
                .Value;

            if (string.IsNullOrWhiteSpace(ownerId))
            {
                loadError =
                    "The authenticated user could not be resolved. Sign in again and retry.";
                return;
            }

            episodes = await EpisodeService.ListAsync(ownerId);
        }
        catch (SafeApplicationException exception)
        {
            Logger.LogWarning(exception, "The episode list query could not be completed.");
            loadError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load episodes.");
            loadError = "VibeCast could not load your episodes. Retry in a moment.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetSupportingText(EpisodeSummary episode) =>
        string.IsNullOrWhiteSpace(episode.Description)
            ? episode.TargetAudience
            : episode.Description;

    private static string FormatUpdatedAt(DateTimeOffset updatedAtUtc) =>
        updatedAtUtc.ToLocalTime().ToString("MMM d, yyyy");
}
