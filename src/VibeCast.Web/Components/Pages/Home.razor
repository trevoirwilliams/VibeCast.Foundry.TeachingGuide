@page "/"
@page "/dashboard"
@attribute [Authorize]

<PageTitle>VibeCast Dashboard</PageTitle>

<div class="page-heading">
  <div>
    <div class="eyebrow">Workspace</div>
    <h1>Generate an episode concept</h1>
    <p>Turn a focused editorial brief into an initial concept through the VibeCast AI boundary.</p>
  </div>

  <a class="btn btn-primary" href="/episodes/create">Create episode brief</a>
</div>

<section class="surface-card">
  <div class="empty-state large">
    <div class="empty-icon">✦</div>
    <div>
      <h2>Start with editorial context</h2>
      <p>
        Define the topic, audience, objective, tone, and language, then generate
        the concept as a complete response or a streamed response.
      </p>
      <a class="btn btn-primary" href="/episodes/create">Generate a concept</a>
    </div>
  </div>
</section>
