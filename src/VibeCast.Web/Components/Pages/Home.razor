@page "/"
@page "/dashboard"
@attribute [Authorize]
@using System.Security.Claims
@using VibeCast.Application.Episodes
@using VibeCast.Application.Media
@using VibeCast.Domain.Episodes
@inject IEpisodeService EpisodeService
@inject IMediaAssetService MediaAssetService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Home> Logger

<PageTitle>VibeCast Dashboard</PageTitle>

<div class="page-heading">
  <div>
    <div class="eyebrow">Workspace overview</div>
    <h1>Dashboard</h1>
    <p>Track your persisted episodes and validated media assets.</p>
  </div>

  <div class="page-actions">
    <a class="btn btn-outline-primary" href="/media/upload">Upload media</a>
    <a class="btn btn-primary" href="/episodes/create">Create episode</a>
  </div>
</div>

@if (isLoading)
{
  <section class="surface-card"><p class="mb-0">Loading your workspace...</p></section>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
  <div class="alert alert-danger" role="alert">@loadError</div>
}
else
{
  <div class="metric-grid metric-grid-two">
    <div class="metric-card">
      <div class="metric-label">Episodes</div>
      <div class="metric-value">@episodes.Count</div>
      <div class="metric-note">Owner-scoped editorial workspaces</div>
    </div>
    <div class="metric-card">
      <div class="metric-label">Media assets</div>
      <div class="metric-value">@assets.Count</div>
      <div class="metric-note">Validated episode and shared media</div>
    </div>
  </div>

  <div class="dashboard-grid mt-4">
    <section class="surface-card">
      <div class="section-heading">
        <div>
          <h2>Recent episodes</h2>
          <p>Your most recently updated editorial workspaces.</p>
        </div>
        <a href="/episodes">View all</a>
      </div>

      @if (episodes.Count == 0)
      {
        <div class="empty-state compact">
          <div class="empty-icon">＋</div>
          <div><strong>No episodes yet</strong><p>Create an editorial brief to begin planning.</p></div>
        </div>
      }
      else
      {
        <div class="table-responsive">
          <table class="table workspace-table mb-0">
            <thead><tr><th>Episode</th><th>Status</th><th>Updated</th></tr></thead>
            <tbody>
              @foreach (EpisodeSummary episode in episodes.Take(5))
              {
                <tr>
                  <td>
                    <a class="table-link" href="@($"/episodes/{episode.Id:D}")">@episode.Title</a>
                    <small>@episode.TargetAudience</small>
                  </td>
                  <td><span class="status-badge @GetStatusBadgeClass(episode.Status)">@GetStatusLabel(episode.Status)</span></td>
                  <td>@episode.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </section>

    <aside class="surface-card">
      <div class="section-heading">
        <div><h2>Quick actions</h2><p>Continue the multimodal episode workflow.</p></div>
      </div>
      <div class="quick-actions">
        <a href="/episodes/create"><span>01</span><div><strong>Create an episode</strong><small>Define a brief and content objective.</small></div></a>
        <a href="/media/upload"><span>02</span><div><strong>Upload media</strong><small>Add episode or shared media.</small></div></a>
        <a href="/media"><span>03</span><div><strong>Open media library</strong><small>Review validated media assets.</small></div></a>
      </div>
    </aside>
  </div>
}

@code {
  private IReadOnlyList<EpisodeSummary> episodes = [];
  private IReadOnlyList<MediaAssetSummary> assets = [];
  private bool isLoading = true;
  private string? loadError;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      AuthenticationState authenticationState =
        await AuthenticationStateProvider.GetAuthenticationStateAsync();

      string? ownerId = authenticationState.User
        .FindFirst(ClaimTypes.NameIdentifier)?.Value;

      if (string.IsNullOrWhiteSpace(ownerId))
      {
        loadError = "The authenticated user could not be resolved. Sign in again and retry.";
        return;
      }

      Task<IReadOnlyList<EpisodeSummary>> episodesTask = EpisodeService.ListAsync(ownerId);
      Task<IReadOnlyList<MediaAssetSummary>> assetsTask = MediaAssetService.ListAsync(ownerId);

      await Task.WhenAll(episodesTask, assetsTask);
      episodes = await episodesTask;
      assets = await assetsTask;
    }
    catch (Exception exception)
    {
      Logger.LogError(exception, "Failed to load the dashboard.");
      loadError = "VibeCast could not load the dashboard. Retry in a moment.";
    }
    finally
    {
      isLoading = false;
    }
  }

  private static string GetStatusLabel(EpisodeStatus status) =>
    status == EpisodeStatus.ReadyForReview ? "Ready for review" : status.ToString();

  private static string GetStatusBadgeClass(EpisodeStatus status) =>
    status switch
    {
      EpisodeStatus.Draft => "badge-neutral",
      EpisodeStatus.Planning => "badge-info",
      EpisodeStatus.ReadyForReview => "badge-warning",
      EpisodeStatus.Published => "badge-success",
      EpisodeStatus.Archived => "badge-neutral",
      _ => "badge-neutral"
    };
}
