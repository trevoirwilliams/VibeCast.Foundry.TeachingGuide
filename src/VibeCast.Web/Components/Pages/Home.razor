@page "/"
@page "/dashboard"
@attribute [Authorize]
@using System.Security.Claims
@using VibeCast.Application.Common
@inject IEpisodeService EpisodeService
@inject IMediaAssetService MediaAssetService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Home> Logger

<PageTitle>VibeCast Dashboard</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Workspace overview</div>
        <h1>Dashboard</h1>
        <p>Track your episodes, media assets, and reusable research sources.</p>
    </div>

    <div class="page-actions">
        <a class="btn btn-outline-primary" href="/media/upload">Upload source</a>
        <a class="btn btn-primary" href="/episodes/create">Create episode</a>
    </div>
</div>

@if (isLoading)
{
    <section class="surface-card">
        <div class="empty-state compact">
            <div class="empty-icon">…</div>
            <div>
                <strong>Loading workspace</strong>
                <p>Retrieving your latest episodes and media.</p>
            </div>
        </div>
    </section>
}
else
{
    <ErrorMessage Message="@loadError" />

    @if (string.IsNullOrWhiteSpace(loadError))
    {
        <div class="metric-grid metric-grid-three">
            <div class="metric-card">
                <div class="metric-label">Episodes</div>
                <div class="metric-value">@episodes.Count</div>
                <div class="metric-note">Owner-scoped editorial workspaces</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Media assets</div>
                <div class="metric-value">@assets.Count</div>
                <div class="metric-note">Episode and shared media</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Shared sources</div>
                <div class="metric-value">@SharedSourceCount</div>
                <div class="metric-note">Reusable PDF and text research</div>
            </div>
        </div>

        <div class="dashboard-grid mt-4">
            <section class="surface-card">
                <div class="section-heading">
                    <div>
                        <h2>Recent episodes</h2>
                        <p>Your most recently updated editorial workspaces.</p>
                    </div>
                    <a href="/episodes">View all</a>
                </div>

                @if (episodes.Count == 0)
                {
                    <div class="empty-state compact">
                        <div class="empty-icon">＋</div>
                        <div>
                            <strong>No episodes yet</strong>
                            <p>Create an episode to begin planning.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table workspace-table mb-0">
                            <thead>
                                <tr>
                                    <th>Episode</th>
                                    <th>Status</th>
                                    <th>Updated</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (EpisodeSummary episode in episodes.Take(3))
                                {
                                    <tr>
                                        <td>
                                            <a class="table-link" href="@($"/episodes/{episode.Id:D}")">
                                                @episode.Title
                                            </a>
                                            <small>@episode.TargetAudience</small>
                                        </td>
                                        <td><EpisodeStatusBadge Status="@episode.Status" /></td>
                                        <td>@FormatUpdatedAt(episode.UpdatedAtUtc)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <aside class="surface-card">
                <div class="section-heading">
                    <div>
                        <h2>Quick actions</h2>
                        <p>Continue the core VibeCast workflow.</p>
                    </div>
                </div>

                <div class="quick-actions">
                    <a href="/episodes/create">
                        <span>01</span>
                        <div>
                            <strong>Create an episode</strong>
                            <small>Define a brief and content objective.</small>
                        </div>
                    </a>
                    <a href="/media/upload">
                        <span>02</span>
                        <div>
                            <strong>Upload a source</strong>
                            <small>Add reusable research to the gallery.</small>
                        </div>
                    </a>
                    <a href="/media">
                        <span>03</span>
                        <div>
                            <strong>Open Source Gallery</strong>
                            <small>Review your shared PDF and text sources.</small>
                        </div>
                    </a>
                </div>
            </aside>
        </div>
    }
}

@code {
    private IReadOnlyList<EpisodeSummary> episodes = [];
    private IReadOnlyList<MediaAssetSummary> assets = [];
    private bool isLoading;
    private string? loadError;

    private int SharedSourceCount =>
        assets.Count(asset =>
            asset.EpisodeId is null &&
            MediaAssetHelpers.IsSupportedDocumentType(asset.ContentType));

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            AuthenticationState authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            string? ownerId = authenticationState.User
                .FindFirst(ClaimTypes.NameIdentifier)?
                .Value;

            if (string.IsNullOrWhiteSpace(ownerId))
            {
                loadError =
                    "The authenticated user could not be resolved. Sign in again and retry.";
                return;
            }

            Task<IReadOnlyList<EpisodeSummary>> episodesTask =
                EpisodeService.ListAsync(ownerId);

            Task<IReadOnlyList<MediaAssetSummary>> assetsTask =
                MediaAssetService.ListAsync(ownerId);

            await Task.WhenAll(episodesTask, assetsTask);

            episodes = await episodesTask;
            assets = await assetsTask;
        }
        catch (SafeApplicationException exception)
        {
            Logger.LogWarning(exception, "The dashboard query could not be completed.");
            loadError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the dashboard.");
            loadError = "VibeCast could not load the dashboard. Retry in a moment.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatUpdatedAt(DateTimeOffset updatedAtUtc) =>
        updatedAtUtc.ToLocalTime().ToString("MMM d, yyyy");
}
