@page "/"
@page "/dashboard"
@attribute [Authorize]

<PageTitle>VibeCast Dashboard</PageTitle>

<div class="page-heading">
  <div>
    <div class="eyebrow">Workspace</div>
    <h1>Build an episode concept</h1>
    <p>Start with a focused editorial brief that can be passed through the application-owned AI boundary.</p>
  </div>

  <a class="btn btn-primary" href="/episodes/create">Create episode brief</a>
</div>

<section class="surface-card">
  <div class="empty-state large">
    <div class="empty-icon">✦</div>
    <div>
      <h2>Prepare the brief first</h2>
      <p>
        Define the topic, audience, objective, tone, and language. This is the
        stable application input for the AI client implementation.
      </p>
      <a class="btn btn-primary" href="/episodes/create">Open the episode brief</a>
    </div>
  </div>
</section>
